<servlet-class>action.servletGeneraPdf</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>servletGeneraPdf</servlet-name>
<url-pattern>/ejecutaServlet.action</url-pattern>
</servlet-mapping>


</web-app>